# Root env for docker compose: used for ${VAR} substitution in docker-compose.yml
# and loaded into the backend container before backend/.env (backend/.env wins).
# Full backend settings: backend/.env.example and backend/app/core/config.py.

# ── Database (container-internal address) ───────────────────────────────────
DATABASE_URL="postgresql+asyncpg://vocalmind:vocalmind_dev@db:5432/vocalmind"
ASSISTANT_DATABASE_URL="postgresql+asyncpg://vocalmind_readonly:vocalmind_readonly_dev@db:5432/vocalmind"

# ── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=""                                 # openssl rand -hex 32

# ── LLM (trigger chains + RAG) ──────────────────────────────────────────────
LLM_PROVIDER=ollama_cloud                     # ollama_cloud | groq
ASSISTANT_LLM_PROVIDER=ollama_cloud           # manager assistant provider
OLLAMA_API_KEY=                               # https://ollama.com/settings → API Keys
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_HEAVY_MODEL=kimi-k2.6:cloud
OLLAMA_CLOUD_FAST_MODEL=ministral-3:8b
# Optional per-stage overrides (empty = heavy/fast default)
OLLAMA_MODEL_EMOTION_SHIFT=
OLLAMA_MODEL_PROCESS_ADHERENCE=
OLLAMA_MODEL_NLI_POLICY=
OLLAMA_MODEL_RAG_JUDGE=
OLLAMA_MODEL_TEXT_TO_SQL=
OLLAMA_MODEL_RAG_SYNTHESIS=
OLLAMA_CLOUD_EMBED_ENABLED=false
GROQ_API_KEY=                                 # https://console.groq.com (LLM_PROVIDER=groq)
LLM_MODEL="llama-3.3-70b-versatile"

# ── RAG / embeddings ────────────────────────────────────────────────────────
EMBEDDING_MODEL="snowflake-arctic-embed2"
EMBEDDING_DIMENSION=1024
QDRANT_COLLECTION_PARENTS="vocalmind_parents"
QDRANT_COLLECTION_SOP_PARENTS="vocalmind_sop_parents"
SOP_RETRIEVAL_TOP_K=3

# ── Where models run ────────────────────────────────────────────────────────
# Default: Kaggle GPU server (services/kaggle). For fully local models use `make up-local`.
IS_LOCAL=false                                # speech/emotion: false = Kaggle, true = local containers
RAG_MODELS_HOST=kaggle                        # embeddings/PDF parsing/rerank: kaggle | local (re-ingest docs after switching)
KAGGLE_SERVER_URL=""                          # e.g. https://<your-domain>.ngrok-free.dev (the notebook also registers itself)
HF_TOKEN=""                                   # pyannote diarization in local containers (accept model terms on HF)

# ── MLflow (only for tools/download_mlflow_model.py) ────────────────────────
MLFLOW_TRACKING_URI="https://dagshub.com/jalalqassas/vocalMind.mlflow"
MLFLOW_TRACKING_USERNAME="jalalqassas"
MLFLOW_TRACKING_PASSWORD=""                   # DagsHub personal access token
